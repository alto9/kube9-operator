{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "ai/vision.schema.json",
    "title": "AI Vision Schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "vision"
    ],
    "properties": {
        "vision": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "title",
                "mission",
                "core_purpose",
                "key_architecture",
                "long_term_vision",
                "key_principles",
                "market_strategy"
            ],
            "properties": {
                "title": {
                    "type": "string"
                },
                "mission": {
                    "type": "string"
                },
                "core_purpose": {
                    "type": "string"
                },
                "key_architecture": {
                    "type": "string"
                },
                "last_validated": {
                    "type": "string",
                    "description": "Optional stewardship date (YYYY-MM-DD) when vision content was last reviewed.",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "long_term_vision": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "strategic_goals"
                    ],
                    "properties": {
                        "strategic_goals": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "now",
                                "next",
                                "later"
                            ],
                            "properties": {
                                "now": {
                                    "type": "string"
                                },
                                "next": {
                                    "type": "string"
                                },
                                "later": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "key_principles": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string"
                    }
                },
                "market_strategy": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "competitive_advantages",
                        "differentiation_from_competitors"
                    ],
                    "properties": {
                        "primary_competitor": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "name",
                                "why_primary",
                                "their_strengths",
                                "last_reviewed"
                            ],
                            "properties": {
                                "name": {
                                    "type": "string"
                                },
                                "why_primary": {
                                    "type": "string"
                                },
                                "their_strengths": {
                                    "type": "array",
                                    "minItems": 1,
                                    "items": {
                                        "type": "string"
                                    }
                                },
                                "last_reviewed": {
                                    "type": "string",
                                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                                }
                            }
                        },
                        "competitive_advantages": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                                "type": "string"
                            }
                        },
                        "differentiation_from_competitors": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    }
}
